  if type == "array" then
    [ .[]
      | select(type == "object" and (.name | type) == "string" and (.name | length) > 0
               and (.url | type) == "string")
      | select((.url
                | sub("^[A-Za-z][A-Za-z0-9+.-]*://"; "")
                | sub("[/?#].*$"; "")
                | sub("^.*@"; "")
                | sub(":[0-9]+$"; "")) == $h)
      | .name ]
    | if length == 1 then .[0] else error("not exactly one matching login") end
  else
    error("login list is not an array")
  end'
