    fm-fleet-tasks.jmtlO1
    fm-timeout-status.FRESHLIVE
    fm-timeout-status.STALEOLD
    other-tool.STALE
  next run rc=0
  TMPDIR after next run:
    fm-timeout-status.FRESHLIVE
    other-tool.STALE
  (end)
