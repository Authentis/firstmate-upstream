== S5: fm_run_timed normal completion restores the caller's TERM trap ==
  run rc=0 trap now: trap -- 'echo "  caller-trap-ran"; exit 7' SIGTERM
  TMPDIR: []
  caller-trap-ran
  subshell rc=7
